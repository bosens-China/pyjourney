---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ChapterWorkbench from "@/components/python/ChapterWorkbench";
import { chapters } from "@/data/chapters";

export function getStaticPaths() {
  return chapters.map((chapter) => ({
    params: { chapter: chapter.id },
    props: { chapter },
  }));
}

const { chapter } = Astro.props;
const { challenge, lessons } = chapter;
const previousLesson = lessons.at(-1);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sample = challenge.cases[0];
---

<StarlightPage
  frontmatter={{
    title: challenge.title,
    description: challenge.description,
    template: "splash",
    pagefind: false,
    prev: false,
    next: false,
  }}
>
  <div class="challenge-grid not-content">
    <section class="challenge-problem" aria-label="挑战题目">
      <div class="chapter-context">
        <p>{chapter.label}</p>
        {previousLesson && (
          <a href={`${base}/${previousLesson.slug}/`}>返回本章小节</a>
        )}
      </div>
      <p>{challenge.description}</p>

      <h2>题目要求</h2>
      <ol>
        {challenge.instructions.map((instruction) => (
          <li>{instruction}</li>
        ))}
      </ol>

      <h2>样例变量</h2>
      <pre><code>{sample.setup}</code></pre>

      <h2>样例输出</h2>
      <pre><code>{sample.expectedOutput}</code></pre>
    </section>

    <section class="challenge-editor" aria-label="编程工作台">
      <ChapterWorkbench
        client:load
        starterCode={challenge.starterCode}
        cases={challenge.cases}
      />
    </section>
  </div>
</StarlightPage>

<style>
  :global(main:has(.challenge-grid)) {
    --sl-content-width: 100rem;
  }

  .challenge-grid {
    display: grid;
    grid-template-columns: minmax(19rem, 0.85fr) minmax(0, 1.25fr);
    align-items: start;
    gap: 1rem;
  }

  .challenge-problem {
    min-width: 0;
    padding: clamp(1rem, 3vw, 1.75rem);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
  }

  .challenge-editor {
    min-width: 0;
  }

  .chapter-context {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-block-end: 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }

  .chapter-context a {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  h2 {
    margin: 1.5rem 0 0.5rem;
    color: var(--sl-color-white);
    font-size: 1rem;
    font-weight: 650;
  }

  ol {
    padding-inline-start: 1.4rem;
    list-style: decimal;
  }

  li + li {
    margin-top: 0.3rem;
  }

  pre {
    overflow: auto;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: var(--sl-color-bg-inline-code);
  }

  code {
    font-family: var(--sl-font-mono);
    font-size: 0.875rem;
  }

  @media (max-width: 52rem) {
    .challenge-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
